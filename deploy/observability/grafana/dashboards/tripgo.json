{
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request duration — p95 (seconds)",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[1m])))",
